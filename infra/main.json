        "[resourceId('Microsoft.Automation/automationAccounts/schedules', parameters('automationAccountName'), 'nightly-2200')]",
        "[resourceId('Microsoft.Automation/automationAccounts/runbooks', parameters('automationAccountName'), 'Stop-TaggedVMs')]"
      ]
    }
